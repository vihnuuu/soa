          "uid": "prometheus"
        },
        "label": "Сервіс",
        "query": {
          "query": "label_values(http_requests_total, service)",
          "refId": "svc"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "trace_id",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        }
      }
    ]
